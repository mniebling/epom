---
import { Image } from 'astro:assets'
import homeFrontBefore from '../assets/gardening/home-front-before.jpg'
import homeFrontAfter from '../assets/gardening/home-front-after.jpg'
import homeBackBefore from '../assets/gardening/home-back-before.jpg'
import homeBackAfter from '../assets/gardening/home-back-after.jpg'
import oakParkBefore from '../assets/gardening/oak-park-before.jpg'
import oakParkDesign from '../assets/gardening/oak-park-design.jpg'
import loganBefore from '../assets/gardening/logan-front-before.jpg'
import loganAfter from '../assets/gardening/logan-front-after.jpg'
import PageLayout from '../layouts/PageLayout.astro'
---

<PageLayout title="Gardening">
	<div class="page">

		<!-- explicitly no header top margin, refactor this later -->
		<h3>What I do</h3>
		<p>
			I empower and support people as they cultivate gardens for themselves and the planet.
			I have a preference for native plants that provide homes and food for our insect friends.
		</p>
		<p>
			I can trim your shrubs, prune your roses, weed and edge garden beds,
			plant and divide perennials, design new garden beds, and provide planting suggestions. Just don’t ask me to mow your grass.
		</p>

		<h3 class="header">Rates</h3>

		<ul class="priceList">
			<li>
				<span class="service">Initial garden consultation (1 hour)</span>
				<span class="price">$50</span>
				<div style="clear: both;"></div>
			</li>
			<li>
				<span class="service">Planting/weeding labor</span>
				<span class="price">$50/hour</span>
				<div style="clear: both;"></div>
			</li>
			<li>
				<span class="service">Plant selection fee</span>
				<span class="price">$250</span>
				<div style="clear: both;"></div>
			</li>
			<li>
				<span class="service">Garden design fee</span>
				<span class="price">$300</span>
				<div style="clear: both;"></div>
			</li>
			<li>
				<span class="service">Automated irrigation system design fee</span>
				<span class="price">$150</span>
				<div style="clear: both;"></div>
			</li>
			<li>
				<span class="service">Plant Purchasing</span>
				<span class="price">$40/hour</span>
				<div style="clear: both;"></div>
			</li>
		</ul>
		<p class="note">
			<strong>Note:</strong>
			<span>I track hours and send a bill at the end of each week I work for you.</span>
		</p>

		<h3 class="header">Past Projects</h3>

		<div class="project">
			<h4 class="projectTitle">My front garden</h4>
			<div class="projectImages">
				<Image
					alt="my garden, before"
					class="before"
					src={ homeFrontBefore }
				/>
				<Image
					alt="my garden, after"
					class="after"
					src={ homeFrontAfter }
				/>
			</div>
		</div>

		<div class="project">
			<h4 class="projectTitle">Oak Park garden design</h4>
			<div class="projectImages">
				<Image
					alt="Oak Park garden design, before"
					class="before"
					src={ oakParkBefore }
				/>
				<Image
					alt="Oak Park garden design, after"
					class="after"
					src={ oakParkDesign }
				/>
			</div>
		</div>

		<div class="project">
			<h4 class="projectTitle">Rain garden / flood abatement</h4>
			<div class="projectImages">
				<Image
					alt="rain garden, before"
					class="before"
					src={ homeBackBefore }
				/>
				<Image
					alt="rain garden, after"
					class="after"
					src={ homeBackAfter }
				/>
			</div>
		</div>

		<div class="project">
			<h4 class="projectTitle">Logan Square front garden</h4>
			<div class="projectImages">
				<Image
					alt="Logan Square front garden, before"
					class="before"
					src={ loganBefore }
				/>
				<Image
					alt="Logan Square front garden, after"
					class="after"
					src={ loganAfter }
				/>
			</div>
		</div>

		<!-- <div class="project">
			<h4 class="projectTitle">Lincoln Park rooftop deck</h4>
			<div class="projectImages">
				<Image
					alt="my garden, before"
					class="before"
					src={ garden }
				/>
				<Image
					alt="my garden, after"
					class="after"
					src={ garden }
				/>
			</div>
		</div> -->

	</div>
</PageLayout>


<style>
	h3 {
		text-align: center;
	}

	h3.header {
		margin-top: 20px;
	}

	.page {
		padding-top: var(--page-top-padding);
		padding-bottom: 50px;
		margin: 0 auto;
		max-width: 600px;
		display: flex;
		align-items: center;
		flex-direction: column;
	}

	/* TODO: This is very fragile, need to put this in a grid or something more logical. */
	.priceList {
		margin-right: 10%;
		width: 75%;
	}

	.service {
		font-weight: bold;
		color: #2c5530;
	}

	.price {
		color: #666;
		float: right;
	}

	.note {
		border-left-color: #2c5530;
		font-style: italic;
	}

	.project {
		align-items: center;
		display: flex;
		flex-direction: column;
		margin: 10px 0;
	}

	.projectImages {
		display: flex;
	}

	.projectImages img {
		display: block;
		height: 300px;
		width: auto;
		margin: 0 5px;
	}
</style>
