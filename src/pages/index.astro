---
import { Image } from 'astro:assets'
import painting from '../assets/paintings/barn-swallow.jpg'
import garden from '../assets/home/garden.jpg'
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout>
	<div class="header">
		<h1>Esther Pomranky</h1>
		<div class="tagline">Chicago-based gardener & teaching artist.</div>

		<div class="heroes">
			<a class="heroLink" href="/gardening">
				<div class="hero gardening">
					<Image
						alt="photo of my home garden"
						class="heroImage"
						src={ garden }
					/>

					<div class="heroText">
						<div class="heroHeader">Gardening</div>
						<div class="heroDescription">I empower and support people to cultivate their own gardens.</div>
					</div>
				</div>
			</a>

			<a class="heroLink" href="/art">
				<div class="hero art">
					<Image
						alt="painting of a blue jay"
						class="heroImage"
						src={ painting }
					/>
					<div class="heroText">
						<div class="heroHeader">Art</div>
						<div class="heroDescription">I enjoy painting, embroidery, and more.</div>
					</div>
				</div>
			</a>
		</div>
	</div>

	<div class="otherLinks">
		<h2 class="otherLinksHeader">Other links</h2>

		<a class="link" href="https://www.youtube.com/channel/UCiV2K5Ni2qZSmBaGwv8G49w">
			<img class="linkIcon" src="/icons/youtube.svg" />
			<span class="linkText">My YouTube art channel</span>
		</a>

		<a class="link icon instagram" href="https://www.instagram.com/epomrankyart">
			<img class="linkIcon" src="/icons/instagram.svg" />
			<span>Instagram</span>
		</a>

		<a class="link" href="/diy-hanging-planters">
			DIY hanging planter tutorial
		</a>
	</div>

</SiteLayout>


<style>
	.header {
		margin-top: 30px;
		text-align: center;
	}

	.tagline {
		margin-top: 15px;
	}

	.heroes {
		display: flex;
		flex-direction: column;
		justify-content: center;
		margin: 25px auto 0 auto;
		width: 100%;
	}

	@media (min-width: 750px) {
		.heroes {
			width: 750px;
		}
	}

	.hero {
		background: lightgray;
		height: 300px;
		margin-bottom: 5px;
		overflow: hidden;
		position: relative;
	}

	.hero:hover .heroText {
		background-color: rgba(0, 0, 0, 0.75);
		transform: translate(-50%, -50%) scale(105%);
	}

	.heroImage {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	/* art direction tweaks for photos, would be better using background-images but need to figure out Astro support first */
	.hero.gardening .heroImage {
		transform: translate(-62%, -52%);
	}

	.hero.art .heroImage {
		transform: translate(-50%, -29%);
	}

	.heroText {
		align-items: center;
		backdrop-filter: blur(2px);
		background-color: rgba(0, 0, 0, 0.5);
		border-radius: 3px;
		display: flex;
		flex-direction: column;
		left: 50%;
		padding: 8px 20px;
		position: absolute;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
		top: 50%;
		transition: all 0.25s;
		transform: translate(-50%, -50%);
	}

	.heroHeader {
		color: white;
		font-size: 32px;
	}

	.heroDescription {
		color: white;
		font-size: 18px;
	}

	.heroLink {
		text-decoration: none;
	}

	.link {
		align-items: center;
		display: flex;
		margin: 0 16px;
	}

	.linkIcon {
		height: 16px;
		margin-right: 4px;
		width: 16px;
	}

	.otherLinks {
		align-items: center;
		display: flex;
		flex-direction: column;
		margin: 40px 0;
	}

	.otherLinks .link {
		margin: 5px 0;
	}

	.otherLinksHeader {
		margin-bottom: 20px;
	}
</style>
