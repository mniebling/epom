---
import { Image } from 'astro:assets'
import SiteLayout from '../layouts/SiteLayout.astro'

// https://docs.astro.build/en/recipes/dynamically-importing-images/
const paintings = import.meta.glob<{ default: ImageMetadata }>('../assets/paintings/*.jpg')
---

<SiteLayout>
	<div class="header">
		<h1>Esther Pomranky</h1>
		<div class="subheader">Chicago-based teaching artist & gardener.</div>

		<div class="links">
			<a class="link" href="/art">
				Art
			</a>
			<a class="link" href="https://www.youtube.com/channel/UCiV2K5Ni2qZSmBaGwv8G49w">
				<img class="link-icon" src="/icons/youtube.svg" />
				<span class="link-text">YouTube</span>
			</a>
			<a class="link icon instagram" href="https://www.instagram.com/epomrankyart">
				<img class="link-icon" src="/icons/instagram.svg" />
				<span>Instagram</span>
			</a>
		</div>
	</div>

	<div class="paintings">
		<div class="paintingCell">
			<Image
				alt="Painting of a Blue Jay"
				class="painting"
				src={ paintings['../assets/paintings/blue-jay.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Baltimore Oriole"
				class="painting"
				src={ paintings['../assets/paintings/baltimore-oriole.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Barn Swallow"
				class="painting"
				src={ paintings['../assets/paintings/barn-swallow.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Purple Finch"
				class="painting"
				src={ paintings['../assets/paintings/purple-finch.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Cardinal"
				class="painting"
				src={ paintings['../assets/paintings/cardinal.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Tufted Titmouse"
				class="painting"
				src={ paintings['../assets/paintings/titmouse.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Bluebird"
				class="painting"
				src={ paintings['../assets/paintings/bluebird.jpg']() }
			/>
		</div>
		<div class="paintingCell">
			<Image
				alt="Painting of a Sparrow"
				class="painting"
				src={ paintings['../assets/paintings/sparrow.jpg']() }
			/>
		</div>
	</div>

	<div class="projects">
		<h2 class="projectsHeader">Projects</h2>

		<a class="link" href="/diy-hanging-planters">
			DIY hanging planter tutorial
		</a>
	</div>
</SiteLayout>


<style>
	.header {
		margin-top: 30px;
		text-align: center;
	}

	.subheader {
		margin-top: 15px;
	}

	.links {
		display: flex;
		justify-content: center;
		margin-top: 25px;
	}

	.link {
		align-items: center;
		display: flex;
		margin: 0 16px;
	}

	.link-icon {
		height: 16px;
		margin-right: 4px;
		width: 16px;
	}

	.paintings {
		display: grid;
		grid-gap: 10px;
		grid-template-columns: repeat(2, 1fr);
		margin: 50px auto 0 auto;
		padding: 0 15px;
	}

	@media (min-width: 700px) {
		.paintings {
			grid-template-columns: repeat(4, 1fr);
			padding: 0 30px;
		}
	}

	.paintingCell {
		display: flex; /* Prevent small whitespace below image in grid cell */
	}

	.paintingCell img {
		height: auto;
		width: 100%;
	}

	.projects {
		align-items: center;
		display: flex;
		flex-direction: column;
		margin: 40px 0;
	}

	.projectsHeader {
		margin-bottom: 20px;
	}
</style>
