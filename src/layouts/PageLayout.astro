---
import NavBar from '../components/NavBar.astro'
import SiteLayout from './SiteLayout.astro'
---

<SiteLayout>
	<NavBar />

	<div class="page">
		<h2>{ Astro.props.frontmatter.title }</h2>
		<slot />
	</div>
</SiteLayout>

<style>
	h2 {
		text-align: center;
	}

	.page {
		line-height: 1.7;
		margin: 0 auto;
		max-width: 500px;
		padding: 50px 25px 0 25px;
	}
</style>
