---
import NavBar from '../components/NavBar.astro'
import SiteLayout from './SiteLayout.astro'

interface Props {
	// TODO: this suggests the wrong level of abstraction for page vs. site layout
	centered?: boolean
	title: string
}
---

<SiteLayout>
	<NavBar />

	<div class:list={["page", { centered: Astro.props.centered }]}>
		<h2>{ Astro.props.title }</h2>
		<slot />
	</div>
</SiteLayout>

<style>
	h2 {
		text-align: center;
	}

	.page {
		line-height: 1.7;
		margin: 0 auto;
		padding: 50px 25px 0 25px;
	}

	.page.centered {
		max-width: 500px;
	}
</style>
